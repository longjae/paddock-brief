APP_ENV=development
APP_USE_SAMPLE_DATA=true
APP_CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional for a future trusted ingestion worker; never expose this to the frontend.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-6-luna
OPENF1_TOKEN=
YOUTUBE_API_KEY=
# Optional third fallback for stable captions from other channels.
# Create a server-side key at https://transcriptapi.com/ (never expose it to Next.js).
TRANSCRIPT_API_KEY=
# Long-running FastAPI deployments only. Vercel Functions cannot keep this socket alive.
LIVE_TIMING_ENABLED=false
LIVE_TIMING_URL=wss://livetiming.formula1.com/signalrcore
# Optional personal F1 TV JWT for Position.z and CarData.z. Never expose to Next.js.
F1_LIVE_TOKEN=
